# 이 파일을 secrets.toml로 복사하고 실제 값을 넣는다. secrets.toml은 Git에 올리지 않는다.
# Streamlit Community Cloud에서는 앱 설정 > Secrets에 같은 내용을 붙여 넣는다.
# 파일은 TOML 문법, **BOM 없는 UTF-8**로 저장할 것 (Windows 메모장·PowerShell Set-Content는 BOM을 붙일 수 있음).
#
# [gsheets] 섹션이 없으면 앱은 임시 로컬 JSON 파일(data/items.json)을 쓰고 "임시 저장소" 경고를 보여준다.
#   (로컬 개발에서 일부러 쓸 때는 환경변수 SHOPPING_STORAGE=json → 경고 대신 안내 한 줄)
# [gsheets]가 있는데 문법이 틀리거나 값이 비어 있으면 JSON으로 넘어가지 않고 오류를 보여준다.

[gsheets]
spreadsheet_id = "구글 시트 URL의 /d/ 와 /edit 사이 문자열"
worksheet = "items"

# Google Cloud 서비스 계정 키(JSON)의 내용을 그대로 옮긴다.
[gsheets.service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "your-service-account@your-project-id.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
